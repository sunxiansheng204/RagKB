# ================= 复制为 .env 后按需修改 =================

# ---------- LLM（OpenAI 兼容协议） ----------
# 默认指向本地 Ollama，端口 11434；也可改为任意 OpenAI 兼容服务：
#   DeepSeek : https://api.deepseek.com/v1
#   火山方舟 : https://ark.cn-beijing.volces.com/api/v3
#   OpenAI   : https://api.openai.com/v1
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ---------- Embedding ----------
# backend 可选：
#   sentence-transformers : 纯本地，模型一次下载后离线可用（默认）
#   openai                : 走 OpenAI 兼容 embedding API（如火山方舟 text-embedding-v3）
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# EMBEDDING_API_KEY=
# EMBEDDING_API_MODEL=text-embedding-v3

# ---------- 检索 ----------
TOP_K=6
CHUNK_SIZE=512
CHUNK_OVERLAP=64
# 是否启用 bge-reranker 重排序（需要下载 bge-reranker-base，默认关闭）
USE_RERANKER=false

# ---------- 服务 ----------
# 默认仅监听本机回环；如需局域网访问改为 0.0.0.0（务必同时配置 API_TOKEN）
HOST=127.0.0.1
PORT=8000

# ---------- 安全 ----------
# 接口鉴权 Token（Authorization: Bearer <token>）。
# 留空 = 演示模式（仅建议本机使用）；生产部署请务必设置随机强口令。
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# CORS 允许来源白名单（英文逗号分隔，禁止使用 *）
# 默认放行本机 Streamlit 前端 (8501)，生产环境替换为你的前端域名
CORS_ORIGINS=http://127.0.0.1:8501,http://localhost:8501

# 单文件上传大小上限（MB）
MAX_UPLOAD_MB=50
